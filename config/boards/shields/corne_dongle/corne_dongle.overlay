#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>

/*
 * Same 14x5 transform as boards/arm/eyelash_corne (default_transform), so the
 * key positions the halves report line up with the existing keymap unchanged.
 * Must be defined BEFORE the layouts file, which references &default_transform.
 */
/ {
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
                    map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                      RC(0,12)           RC(0,13) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)             RC(2,12) RC(4,12) RC(3,12)  RC(1,13) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,2)              RC(1,12)           RC(2,13) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                    RC(3,3) RC(3,4) RC(3,5)                                         RC(3,13) RC(3,7) RC(3,8)
        >;
    };
};

#include "corne_dongle-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan_mock;
        zmk,physical-layout = &default_layout;
    };

    /* No local keys: the dongle only receives key events from the halves. */
    kscan_mock: kscan_mock {
        compatible = "zmk,kscan-mock";
        columns = <14>;
        rows = <5>;
        events = <0>;
    };

    /*
     * Placeholder encoder. The real EC11 is on the left half; its rotation is
     * sent to the dongle as sensor index 0. ZMK sizes its per-sensor state from
     * the central's zmk,keymap-sensors node, so without one the dongle has zero
     * slots and the left encoder would write out of bounds.
     * P1.04 / P1.06 are free nice!nano pins (not used by the planned display
     * wiring); nothing is connected, so the pull-ups keep it idle.
     * steps / triggers-per-rotation match boards/arm/eyelash_corne.
     */
    dongle_encoder: dongle_encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <40>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        triggers-per-rotation = <20>;
        sensors = <&dongle_encoder>;
    };

    chosen {
        /* Dummy strip, see "Dummy underglow" below. */
        zmk,underglow = &led_strip;
    };
};

/*
 * ---------------------------------------------------------------------------
 * Dummy underglow (nothing is connected)
 *
 * &rgb_ug key presses are handled by the dongle, which then forwards them to
 * the halves. It can only do that if it knows the behavior, and ZMK only builds
 * RGB underglow when a strip is defined. So the dongle gets a one-LED strip on
 * a free pin (P1.15) on SPIM3; the real LEDs live on the halves.
 * CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER=n in corne_dongle.conf keeps this strip
 * from switching the ext-power rail, which also powers the display.
 * ---------------------------------------------------------------------------
 */
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 15)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 15)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <1>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

/*
 * ---------------------------------------------------------------------------
 * ST7735 SPI LCD, 160x128 (hardware test showed 128 rows, not the planned 0.96" 160x80)
 *
 * Wiring (nice!nano v2):
 *   SCK  P1.13   MOSI P1.11   CS  P0.20
 *   DC   P0.17   RES  P0.22   BLK P0.24
 *   VCC  nice!nano VCC (3.3 V, switched by ext-power on P0.13)   GND
 *
 * Uses SPIM2 with its own pinctrl. The board's spi1/i2c0 (which also use
 * P1.13 / P1.11 / P0.17 / P0.20) stay disabled.
 *
 * Panel init values: see the comment in the st7735 node below.
 * Tune on hardware if needed:
 *   - wrong position / garbage edge  -> x-offset / y-offset (and caset/raset)
 *   - mirrored / rotated             -> madctl
 *   - red and blue swapped           -> rgb-is-inverted
 *   - colours look negative          -> toggle inversion-on (currently ON, on purpose)
 * ---------------------------------------------------------------------------
 */

&pinctrl {
    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 11)>;
        };
    };

    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 11)>;
            low-power-enable;
        };
    };
};

&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    st7735: st7735s@0 {
        compatible = "sitronix,st7735r";
        reg = <0>;
        spi-max-frequency = <8000000>;
        cmd-data-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
        reset-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;

        /*
         * The panel turned out to be a 160x128 ST7735 (1.8"-class), not the
         * 0.96" 160x80. First hardware test with 160x80 values showed: image
         * 80 rows tall with ~26 rows of garbage above / ~22 below, inverted
         * colours (black background), and text sheared one pixel per row
         * (x-offset 1 pushed the window past the last column).
         *
         * Second test (Adafruit 160x128 power/gamma values, inversion off):
         * whole panel plain white, no text. So power/gamma/frame values are
         * back to the Longan Nano set, which visibly drove this glass in the
         * first test; only geometry and inversion differ from that test.
         * madctl / rgb-is-inverted kept: orientation was already correct.
         */
        width = <160>;
        height = <128>;
        x-offset = <0>;
        y-offset = <0>;
        madctl = <0x78>;
        colmod = <0x05>;
        rgb-is-inverted;
        inversion-on; /* panel colour inversion (INVON): whole screen shown as a negative */

        caset = [00 00 00 9f];
        raset = [00 00 00 7f];
        pwctr1 = [62 02 04];
        pwctr2 = [c0];
        pwctr3 = [0d 00];
        pwctr4 = [8d 6a];
        pwctr5 = [8d ee];
        invctr = <0x03>;
        frmctr1 = [05 3a 3a];
        frmctr2 = [05 3a 3a];
        frmctr3 = [05 3a 3a 05 3a 3a];
        vmctr1 = <0x0e>;
        gamctrp1 = [10 0e 02 03 0e 07 02 07 0a 12 27 37 00 0d 0e 10];
        gamctrn1 = [10 0e 03 03 0f 06 02 08 0a 13 26 36 00 0d 0e 10];
    };
};

/ {
    chosen {
        zephyr,display = &st7735;
    };
};

/* Backlight held on for now. Phase 4 replaces this with PWM dimming / idle-off. */
&gpio0 {
    lcd_backlight_on {
        gpio-hog;
        gpios = <24 GPIO_ACTIVE_HIGH>;
        output-high;
    };
};
